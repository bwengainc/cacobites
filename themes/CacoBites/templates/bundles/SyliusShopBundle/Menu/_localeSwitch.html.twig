{% if locales|length > 1 %}
    <div class="ui pointing dropdown link item" id="sylius-locale-selector" {{ sylius_test_html_attribute('locale-selector') }}>
        <span class="text sylius-active-locale" {{ sylius_test_html_attribute('active-locale') }}>
            {% if active starts with 'sw' %}
                <i class="tz flag"></i>
            {% elseif active starts with 'en' %}
                <i class="us flag"></i>
            {% endif %}
            {{ active|sylius_locale_name }}
        </span>
        <i class="dropdown icon"></i>
        <div class="menu">
            {% for code in locales %}
                {% if code is not same as(active) %}
                    <a href="{{ path('sylius_shop_switch_locale', {'code': code}) }}" class="item sylius-available-locale" {{ sylius_test_html_attribute('available-locale') }}>
                        {% if code starts with 'sw' %}
                            <i class="tz flag"></i>
                        {% elseif code starts with 'en' %}
                            <i class="gb flag"></i>
                        {% endif %}
                        {{ code|sylius_locale_name }}
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>
{% endif %}
